# Supabase Transaction pooler; application runtime.
DATABASE_URL=
# Supabase Session pooler or direct connection; used only by drizzle-kit migrations.
DATABASE_URL_MIGRATE=
# Enable only after additive migration 0029 has been applied.
DOCUMENT_IMAGE_UPLOADS_ENABLED=false
IMAGE_UPLOAD_RETENTION_HOURS=168
IMAGE_UPLOAD_MAX_PENDING_FILES=100
IMAGE_UPLOAD_MAX_PENDING_BYTES=524288000
GOOGLE_GENERATIVE_AI_API_KEY=
AI_CHAT_MODEL=gemini-3.8-flash
AI_LIGHT_MODEL=gemini-3.5-flash-lite
AI_BACKUP_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ENABLE_RERANK=false
## Keep OFF in production until explicitly approved after semantic acceptance.
ENABLE_CONTEXT_EXPANSION=false
